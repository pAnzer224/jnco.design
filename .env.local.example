# NEXT_PUBLIC_ vars are baked into the static bundle at build time.
# This var points to your Cloudflare Worker URL — it's safe to be public
# (the worker itself enforces the allowlist, rate limits, and holds the real API key).

# 1. Deploy your Cloudflare Worker first (see workers/chat-proxy/README.md)
# 2. Paste your worker URL below, then rebuild & redeploy the portfolio

NEXT_PUBLIC_CHAT_WORKER_URL=https://jnco-chat-proxy.YOUR_SUBDOMAIN.workers.dev
